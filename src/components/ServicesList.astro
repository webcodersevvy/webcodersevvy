---
import SectionHeading from "./SectionHeading.astro";
import { services } from "../data/services";
---

<section class="section rule-top" aria-labelledby="services-heading">
  <div class="wrap">
    <SectionHeading
      index="02"
      label="Services"
      title="What I can build for you"
      headingId="services-heading"
      blurb="Six sharp offers. If your problem sits at the intersection of design and engineering, we should talk."
    />
    <ul class="rows" data-reveal-group>
      {services.map((s) => (
        <li class="row">
          <span class="n meta" aria-hidden="true">{s.index}</span>
          <div class="rb">
            <h3 class="t">{s.title}</h3>
            <p class="d">{s.desc}</p>
            <p class="tags">{s.tags.map((t) => <span class="tag">{t}</span>)}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="more"><a class="btn btn-ghost" href="/services">All services <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<style>
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-2);
    padding: var(--s-6) 0;
    border-bottom: var(--rule);
  }

  .n {
    color: var(--accent-strong);
  }

  .t {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    text-transform: uppercase;
    margin: 0 0 var(--s-2);
    font-weight: 400;
  }

  .d {
    margin: 0;
    color: var(--ink-60);
    max-width: 62ch;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: var(--s-3) 0 0;
  }

  .more {
    margin: var(--s-8) 0 0;
  }

  @media (min-width: 768px) {
    .row {
      grid-template-columns: 4rem 1fr;
      gap: var(--s-4);
    }

    .t {
      font-size: 1.9rem;
    }
  }
</style>
